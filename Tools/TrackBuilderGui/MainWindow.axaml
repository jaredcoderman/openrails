<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:TrackBuilderGui"
        x:Class="TrackBuilderGui.MainWindow"
        Title="Track Builder"
        Width="1280"
        Height="800"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="300,4,*">
    <Border Grid.Column="0"
            Background="#121820"
            Padding="16">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="10">
          <TextBlock Text="Track Builder"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Foreground="#F2F4F8" />
          <TextBlock Text="Preview fitted network, then generate path/TDB from selected ends."
                     TextWrapping="Wrap"
                     Foreground="#9AA3B2"
                     FontSize="12" />
          <Button Name="LoadButton"
                  Content="Load network JSON…"
                  HorizontalAlignment="Stretch"
                  Click="OnLoadClicked" />
          <Button Name="FitButton"
                  Content="Fit to view"
                  HorizontalAlignment="Stretch"
                  Click="OnFitClicked" />

          <TextBlock Text="Endpoints"
                     FontWeight="SemiBold"
                     Foreground="#F2F4F8"
                     Margin="0,12,0,0" />
          <TextBlock Text="Cyan = free end · click start then goal"
                     Foreground="#6B7380"
                     FontSize="11"
                     TextWrapping="Wrap" />
          <TextBlock Name="StartLabel"
                     Foreground="#EF9A9A"
                     FontSize="12"
                     Text="Start: (none)" />
          <TextBlock Name="GoalLabel"
                     Foreground="#A5D6A7"
                     FontSize="12"
                     Text="Goal: (none)" />
          <Button Name="ClearSelectionButton"
                  Content="Clear selection"
                  HorizontalAlignment="Stretch"
                  Click="OnClearSelectionClicked" />
          <Button Name="GenerateButton"
                  Content="Generate path…"
                  HorizontalAlignment="Stretch"
                  IsEnabled="False"
                  Click="OnGenerateClicked" />

          <TextBlock Text="Switch roles"
                     FontWeight="SemiBold"
                     Foreground="#F2F4F8"
                     Margin="0,12,0,0" />
          <TextBlock Text="POINTS (blue) = facing approach — take the spur from this side
MAIN (yellow) = default through
SPUR (orange) = diverging branch"
                     Foreground="#9AA3B2"
                     FontSize="11"
                     TextWrapping="Wrap" />
          <Border Background="#1A222E"
                  CornerRadius="4"
                  Padding="8"
                  Margin="0,4,0,0">
            <TextBlock TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="#F2F4F8"
                       Text="In Open Rails the path can be correct while the switch still sits on MAIN. Before the junction: press G to throw the next switch for your path (Shift+G behind). If needed, Ctrl+M toggles Manual mode — stay in Auto when you can. Alt+click the switch also works." />
          </Border>

          <TextBlock Text="Route paths"
                     FontWeight="SemiBold"
                     Foreground="#F2F4F8"
                     Margin="0,12,0,0" />
          <TextBlock Text="Check paths to delete (.pat + matching .srv/.act)"
                     Foreground="#6B7380"
                     FontSize="11"
                     TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,8,Auto">
            <Button Name="PathsDropDownButton"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft"
                        ShowMode="Standard"
                        Opening="OnPathsFlyoutOpening">
                  <Border Width="260"
                          MaxHeight="320"
                          Background="#1A222E"
                          Padding="8">
                    <DockPanel LastChildFill="True">
                      <StackPanel DockPanel.Dock="Top"
                                  Orientation="Horizontal"
                                  Spacing="8"
                                  Margin="0,0,0,8">
                        <Button Content="All"
                                Padding="8,2"
                                Click="OnSelectAllPathsClicked" />
                        <Button Content="None"
                                Padding="8,2"
                                Click="OnSelectNonePathsClicked" />
                        <Button Content="Refresh"
                                Padding="8,2"
                                Click="OnRefreshPathsClicked" />
                      </StackPanel>
                      <ScrollViewer VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl Name="PathCheckList">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:PathEntry">
                              <CheckBox Content="{Binding Id}"
                                        IsChecked="{Binding IsChecked}"
                                        Margin="0,2"
                                        Foreground="#F2F4F8" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </DockPanel>
                  </Border>
                </Flyout>
              </Button.Flyout>
              <TextBlock Name="PathsDropDownLabel"
                         Text="Select paths…"
                         TextTrimming="CharacterEllipsis" />
            </Button>
            <Button Name="DeletePathsButton"
                    Grid.Column="2"
                    Content="Delete"
                    IsEnabled="False"
                    Click="OnDeletePathsClicked" />
          </Grid>

          <TextBlock Text="Drag to pan · wheel to zoom · click ends to select"
                     Foreground="#6B7380"
                     FontSize="11"
                     Margin="0,8,0,0"
                     TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Name="StatusText"
                   DockPanel.Dock="Bottom"
                   Margin="0,16,0,0"
                   TextWrapping="Wrap"
                   Foreground="#9AA3B2"
                   FontSize="12"
                   Text="No network loaded." />
      </DockPanel>
    </Border>

    <GridSplitter Grid.Column="1"
                  Width="4"
                  Background="#2A3342"
                  ResizeDirection="Columns" />

    <Border Grid.Column="2" Background="Black">
      <local:TrackMapControl x:Name="Map" />
    </Border>
  </Grid>
</Window>
